# NOTE: GitHub Pages ignores .htaccess, so none of these headers or options take effect
# there. They only apply if the site is served by Apache (e.g. the magickmuse.com host).
# The Content-Security-Policy lives in a <meta> tag in each page instead.

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Prevent directory listing
Options -Indexes

# Hide server signature
ServerSignature Off
