# The Magick Manuscript wiki: every request goes through index.php,
# except the public CSS/JS in assets/. Code, config and data are never served directly.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Same single address as the rest of the site (this folder's rules replace the main .htaccess rules)
  RewriteCond %{HTTP_HOST} ^www\.magickmuse\.com$ [NC]
  RewriteRule ^ https://magickmuse.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^(lib|cli|templates)(/|$) - [F,L]
  RewriteRule ^(config\.local\.php|config\.sample\.php|README\.md)$ - [F,L]
  RewriteCond %{REQUEST_URI} !/assets/(wiki\.css|wiki\.js|checkout\.js|astro/[a-z]+\.png)$
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^(config\.local\.php|config\.live\.php|deploy\.local\.php|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>
